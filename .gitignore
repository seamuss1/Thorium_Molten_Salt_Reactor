# Python bytecode and build products
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
build/
dist/
sdist/
wheels/

# Node
node_modules/

# Virtualenvs and repo-local interpreters. .runtime-env/ and .mamba/ are
# multi-gigabyte trees on the Windows dev host -- never start tracking them.
.env
.venv
venv/
env/
.runtime-env/
.mamba/

# Tool caches and coverage output
.tmp/
.pip-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log

# External MSD-TP acquisition artifacts.
# See docs/msd-tp-thermophysical-data.md for the acquisition policy.
MSTDBTP_GUI_windows_x86.exe
*.hdf5

# Reactor platform runtime outputs. Every bundle the CLI and the web job
# runner write lands under results/<case>/<run_id>/.
results/*
!results/.gitkeep
!results/README.md

# Stray solver output. OpenMC writes these into its working directory, so
# running it from the repository root drops them here. Anchored to the root
# with a leading slash: the previous repo-wide *.xml/*.png/*.svg patterns
# silently swallowed any new XML input or documentation image anywhere in the
# tree, and needed !resources/** and !archive/** escapes to undo themselves.
/*.h5
/*.out
/*.ppm
/*.png
/*.svg
/*.obj
/*.xml
